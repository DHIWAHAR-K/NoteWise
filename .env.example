# AssemblyAI
ASSEMBLYAI_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=notewise-kb
PINECONE_ENVIRONMENT=

# LLM provider (choose one)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Mark 3 — JWT auth (required for /auth/register, /auth/login, and Bearer-protected routes)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Mark 3 — Moonshot (Kimi) vision for /imaging/classify (OpenAI-compatible endpoint)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_VISION_MODEL=moonshot-v1-8k-vision-preview

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Backend (optional overrides)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL (Mark 2) — set DATABASE_URL OR the split vars below (app builds URL if DATABASE_URL unset)
DATABASE_URL=postgresql+asyncpg://notewise:notewise@127.0.0.1:5432/notewise
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=notewise
POSTGRES_PASSWORD=notewise
POSTGRES_DB=notewise

# MongoDB (Mark 2) — chat history; set MONGODB_URI OR split vars (app builds URI if MONGODB_URI unset)
MONGODB_URI=mongodb://notewise:notewise@127.0.0.1:27017/notewise?authSource=admin
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGO_ROOT_USER=notewise
MONGO_ROOT_PASSWORD=notewise

# Frontend (Vite) — API prefix or full origin (no trailing slash); empty = use /api proxy in dev
# Example production: https://notewise-api.onrender.com
VITE_API_BASE=

# Render (Mark 2–3): sync render.yaml from repo root. Two Private Services (Postgres + Mongo) need Starter-or-higher plans.
# Smoke order: GET /health, /health/db, /health/mongo → POST /auth/register → POST /auth/login → GET /auth/me (Authorization: Bearer) →
# GET /chat/conversations → POST /scribe/sessions (optional) → POST /imaging/classify (requires MOONSHOT_API_KEY).
# Set JWT_SECRET, MOONSHOT_API_KEY, CORS_ORIGINS (frontend origin), and other keys in the Render dashboard.
